# Base URL of the games-night backend API (NestJS).
# The Socket.IO/WebSocket URL is derived from this value at runtime.
# Local dev:   http://localhost:3000
# Production:  https://your-api.up.railway.app
VITE_API_URL=http://localhost:3000

# Clerk publishable key for games-master (host) authentication.
# Find it in the Clerk dashboard or via `clerk env pull`. Safe to expose (it
# ships in the client bundle); the secret key lives only on the backend.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
